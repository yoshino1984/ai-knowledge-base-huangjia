# LLM provider selection
LLM_PROVIDER=deepseek

# Model API keys. Fill only the providers you use.
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=

# Optional GitHub token for a higher API rate limit.
GITHUB_TOKEN=

# Optional OpenClaw publisher settings.
OPENCLAW_ACCOUNT=
OPENCLAW_CHANNEL=openclaw-weixin
OPENCLAW_TARGET=

# Local pipeline defaults.
KB_PIPELINE_SOURCES=github,rss
KB_PIPELINE_LIMIT=5
KB_COLLECT_SOURCES=github,rss
KB_COLLECT_LIMIT=20
